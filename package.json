{
  "name": "spendlog",
  "version": "0.1.3",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev --workspace apps/backend",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "dev:mobile": "cd apps/mobile-app && flutter run",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace apps/backend",
    "build:frontend": "npm run build --workspace apps/frontend",
    "seed": "npm run seed --workspace apps/backend",
    "test": "npm run test --workspace apps/backend",
    "version:current": "node -p \"require('./package.json').version\"",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run",
    "certs": "node scripts/ensure-certs.js",
    "certs:force": "node scripts/ensure-certs.js --force",
    "certs:letsencrypt": "bash scripts/setup-letsencrypt.sh",
    "pm2:start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs --lines 100",
    "pm2:logs:backend": "pm2 logs spendlog-backend --lines 100",
    "pm2:logs:frontend": "pm2 logs spendlog-frontend --lines 100",
    "pm2:save": "pm2 save",
    "pm2:persist": "node scripts/pm2-persist.js",
    "deploy": "npm ci && npm run build && npm run pm2:start && npm run pm2:save"
  },
  "devDependencies": {
    "release-it": "20.2.1"
  }
}
