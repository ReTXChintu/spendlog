# Single source of environment config for the whole SpendLog monorepo.
# Copy to `.env` at the repo root: cp .env.example .env
#
#   backend  — reads this file directly (see apps/backend/src/env.ts)
#   frontend — Vite reads it via `envDir` in apps/frontend/vite.config.ts;
#              only VITE_-prefixed vars are exposed to browser code
#   mobile   — scripts/dev.js passes MOBILE_API_URL to `flutter run` as a
#              --dart-define

# ---------------------------------------------------------------- backend ---

# MongoDB connection string, including the database name. Mongoose creates
# collections and indexes on demand — there is no migration step.
#
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/spendlog?retryWrites=true&w=majority
#   Local:  mongodb://localhost:27017/spendlog
DATABASE_URL="mongodb://localhost:27017/spendlog"

PORT=4000

# Random long string used to sign session JWTs.
JWT_SECRET="change-me-to-a-long-random-string"

# From Google Cloud Console > APIs & Services > Credentials.
# One consent screen covers both sign-in and Gmail read access, so this is
# the only OAuth client the backend needs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match a redirect URI registered on the OAuth client. A
# single callback serves sign-in and any later Gmail reconnect.
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/auth/google/callback"

# Where to send the browser after the Gmail OAuth callback completes.
FRONTEND_URL="http://localhost:5173"

# ------------------------------------------------------- deployment (TLS) ---
# Leave both empty for local development: the apps serve plain HTTP, and
# Google exempts localhost from its HTTPS requirement.
#
# On a server, just set the paths — if no certificate is there, both
# servers generate a self-signed one at startup. `npm run certs` does the
# same thing up front, and `npm run certs:force` regenerates.
# These are two distinct FILE paths, not a directory:
#   SSL_CERT_PATH="/opt/var/spendlog/certs/spendlog.crt"
#   SSL_KEY_PATH="/opt/var/spendlog/certs/spendlog.key"
SSL_CERT_PATH=""
SSL_KEY_PATH=""

# Name the certificate is issued for. Defaults to the hostname in
# FRONTEND_URL. Set it explicitly when the browser reaches the app by a
# different address than the backend redirect uses.
SSL_HOST=""

# --------------------------------------------- hostname + trusted certs ---
# Google refuses IP addresses as OAuth redirect URIs, and Android refuses
# self-signed certificates, so a deployed instance needs a real hostname
# and a real certificate. A free DuckDNS subdomain gives you both:
#
#   1. Sign in at https://www.duckdns.org, create a subdomain, point it at
#      this server's IP, and copy the token shown at the top of the page.
#   2. Fill these in, then run:  sudo ./scripts/setup-letsencrypt.sh
#
# duckdns.org is on the Public Suffix List, so each subdomain gets its own
# Let's Encrypt rate limit — unlike nip.io/sslip.io, where every subdomain
# in the world shares one exhausted bucket.
DUCKDNS_DOMAIN=""            # just the label, e.g. "spendlog"
DUCKDNS_TOKEN=""
LETSENCRYPT_EMAIL=""         # for expiry notices
# Seconds to wait for the challenge TXT record to propagate.
DUCKDNS_PROPAGATION_SECONDS=30

# Port for the built frontend served by apps/frontend/server.js under PM2.
# This is the only port that needs to be open — pick something above 1024
# that doesn't collide with anything already holding 80/443 (Traefik, a
# control panel, etc.). 8443 is a conventional HTTPS alternative.
FRONTEND_PORT=5173

# ------------------------------------------------ single-port deployment ---
# The frontend forwards /api/* to the backend, so one HTTPS port serves the
# whole app from one origin. That keeps clear of whatever owns 80/443, means
# only the frontend needs the TLS key (Let's Encrypt's privkey.pem is
# root-readable only), removes CORS, and lets the backend stay off the
# internet entirely.
#
# To enable it, set these two — the backend then listens on loopback in
# plain HTTP, reachable only through the proxy:
#   BACKEND_HOST="127.0.0.1"
#   BACKEND_TLS="false"
# and point the clients at the prefix rather than a second port:
#   VITE_API_URL="/api"
#   MOBILE_API_URL="https://yourname.duckdns.org:8443/api"
#   FRONTEND_URL="https://yourname.duckdns.org:8443"
#   GOOGLE_OAUTH_REDIRECT_URI="https://yourname.duckdns.org:8443/api/auth/google/callback"
#
# Leave both unset to expose the backend directly on its own port instead.
BACKEND_HOST=""
BACKEND_TLS=""

# Where the proxy sends /api traffic, and the prefix it strips. Defaults to
# http://127.0.0.1:$PORT and /api — only set these if you moved something.
API_PROXY_TARGET=""
API_PROXY_PREFIX=""

# --------------------------------------------------------------- frontend ---

VITE_API_URL="http://localhost:4000"
# Same value as GOOGLE_CLIENT_ID above — repeated with the VITE_ prefix
# because only VITE_-prefixed vars reach browser code.
VITE_GOOGLE_CLIENT_ID=""

# ----------------------------------------------------------------- mobile ---

# 10.0.2.2 is how the Android emulator reaches the host machine's localhost.
# On a physical device, use your machine's LAN IP (e.g. http://192.168.1.5:4000).
MOBILE_API_URL="http://10.0.2.2:4000"
