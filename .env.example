# Single source of environment config for the whole monorepo.
# Copy to `.env` at the repo root: cp .env.example .env
#
#   backend  — reads this file directly (see apps/backend/src/env.ts)
#   frontend — Vite reads it via `envDir` in apps/frontend/vite.config.ts;
#              only VITE_-prefixed vars are exposed to browser code
#   mobile   — scripts/dev.js passes MOBILE_API_URL to `flutter run` as a
#              --dart-define

# ---------------------------------------------------------------- backend ---

# SQLite by default for zero-setup local dev. The relative path resolves
# against apps/backend/prisma/. Swap to a postgresql:// URL later by also
# changing the datasource provider in apps/backend/prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

PORT=4000

# Random long string used to sign session JWTs.
JWT_SECRET="change-me-to-a-long-random-string"

# From Google Cloud Console > APIs & Services > Credentials.
# Used both for "Sign in with Google" (idToken verification) and for the
# Gmail read-only OAuth flow used to auto-import bank/UPI emails.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match a redirect URI registered on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/ingestion/email/callback"

# Where to send the browser after the Gmail OAuth callback completes.
FRONTEND_URL="http://localhost:5173"

# --------------------------------------------------------------- frontend ---

VITE_API_URL="http://localhost:4000"
# Same value as GOOGLE_CLIENT_ID above — repeated with the VITE_ prefix
# because only VITE_-prefixed vars reach browser code.
VITE_GOOGLE_CLIENT_ID=""

# ----------------------------------------------------------------- mobile ---

# 10.0.2.2 is how the Android emulator reaches the host machine's localhost.
# On a physical device, use your machine's LAN IP (e.g. http://192.168.1.5:4000).
MOBILE_API_URL="http://10.0.2.2:4000"
